# /opt/fixassist/.env on the server (chmod 600). Never commit the real file.

# Public hostname, e.g. fixassist.duckdns.org (A record -> the VM's public IP)
DOMAIN=

# Set by the deploy workflow on every release
APP_IMAGE=ghcr.io/OWNER/REPO:latest

# Generated by bootstrap.sh
POSTGRES_PASSWORD=
# Signs the "Worked / Didn't work" links in alert emails (32+ characters)
APP_SECRET=

# Who can open /admin (comma-separated emails)
STAFF_EMAILS=
# Optional: lets a scraper inside the Docker network read /metrics
METRICS_TOKEN=

# Email: "off" until a real domain + Resend are set up; partners then get
# sign-in links from `docker compose exec app /app admin login-link --email ...`
EMAIL_MODE=off
RESEND_API_KEY=
EMAIL_FROM=

# Backups: Cloudflare R2 (S3 API). Leave WALG_S3_PREFIX empty to disable.
WALG_S3_PREFIX=s3://BUCKET/fixassist
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# GitHub App (optional): open /admin/github as staff, click "Create the GitHub
# App", and paste the values it shows here. Founders then see "Connect your
# code" on their Setup page.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
